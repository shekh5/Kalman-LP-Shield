# KalmanGuard Environment Configuration
# Copy this file to .env and edit as needed.

# ===========================================
# DEMO MODE (default - runs locally with synthetic data)
# ===========================================
# Demo mode works out of the box with no configuration needed!
DEMO_MODE=true
TARGET_CHAINS=sepolia

# ===========================================
# SEPOLIA MODE (for on-chain judge demo)
# Set DEMO_MODE=false to activate
# ===========================================

# RPC endpoint
RPC_URL_SEPOLIA=https://0xrpc.io/sep

# Sepolia deployer key (32-byte hex): 0x + 64 hex chars
PRIVATE_KEY=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Paste contract addresses after deployment
KALMANGUARD_HOOK_SEPOLIA=
AGENT_CONTROLLER_SEPOLIA=

# On-chain proof loop (AgentController.heartbeat)
ENABLE_HEARTBEAT_TX=true
HEARTBEAT_TX_MS=60000
