# KalmanGuard Environment Variables
# Copy this file to .env and fill in your values

# ================================
# RPC ENDPOINTS
# ================================
RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ================================
# PRIVATE KEYS (KEEP SECRET!)
# ================================
# Agent operator private key (for signing transactions)
PRIVATE_KEY=0x...

# Flashbots auth key for MEV protection
FLASHBOTS_AUTH_KEY=0x...

# ================================
# API KEYS
# ================================
# Chainlink data feeds
CHAINLINK_API_KEY=

# LI.FI API key (optional, for cross-chain)
LIFI_API_KEY=

# WalletConnect project ID
VITE_WALLETCONNECT_PROJECT_ID=

# ================================
# INFRASTRUCTURE
# ================================
# Redis URL (for local development)
REDIS_URL=redis://localhost:6379

# Grafana admin password
GRAFANA_PASSWORD=admin

# ================================
# CONTRACT ADDRESSES
# ================================
# These will be filled after deployment
KALMANGUARD_HOOK_MAINNET=0x...
KALMANGUARD_HOOK_ARBITRUM=0x...
KALMANGUARD_HOOK_OPTIMISM=0x...
KALMANGUARD_HOOK_POLYGON=0x...
KALMANGUARD_HOOK_BASE=0x...

PRIVATE_ORDER_POOL_MAINNET=0x...
RISK_ORACLE_REGISTRY_MAINNET=0x...
AGENT_CONTROLLER_MAINNET=0x...

# ================================
# ENS CONFIGURATION
# ================================
ENS_DOMAIN=kalmanguard.eth
ENS_RESOLVER=0x...

# ================================
# AGENT CONFIGURATION
# ================================
# Update interval in seconds (default: 12 = 1 block)
AGENT_UPDATE_INTERVAL=12

# Max gas price in Gwei
AGENT_MAX_GAS_PRICE=50

# Enable Flashbots protection
AGENT_FLASHBOTS_ENABLED=true

# Emergency threshold (risk score 0-100)
AGENT_EMERGENCY_THRESHOLD=90

# ================================
# KALMAN FILTER PARAMETERS
# ================================
KALMAN_PROCESS_NOISE=0.01
KALMAN_MEASUREMENT_NOISE=0.005
KALMAN_ADAPTATION_RATE=0.1

# ================================
# FEE PARAMETERS (basis points)
# ================================
FEE_BASE=30
FEE_MIN=5
FEE_MAX=100
